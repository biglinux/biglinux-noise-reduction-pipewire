-pub const AUTO_MIC_TARGET_DBFS_MAX: f32 = 0.0;
+/// Target for the AGC's robust raw speech-peak reference, not LUFS or a volume
+/// fraction. Keep headroom for transients: a target at digital full scale is not
+/// a safe normal speaking level. These are engineering defaults, not a broadcast
+/// loudness standard. The existing UI mapping remains 70..100%: -18..-6 dBFS,
+/// with its midpoint (85%) at -12 dBFS. Prefer a plain "Voice level" label in UI.
+pub const AUTO_MIC_TARGET_DBFS_DEFAULT: f32 = -12.0;
+pub const AUTO_MIC_TARGET_DBFS_MIN: f32 = -18.0;
+pub const AUTO_MIC_TARGET_DBFS_MAX: f32 = -6.0;
 /// The slider percentage the dBFS min/max map to (the useful band, not 0..100).
 pub const AUTO_MIC_TARGET_PCT_MIN: f32 = 70.0;
 pub const AUTO_MIC_TARGET_PCT_MAX: f32 = 100.0;
@@ -461,4 +463,18 @@ mod tests {
         assert!((NoiseModel::GtcrnDns3.ladspa_control() - 0.0).abs() < f32::EPSILON);
         assert!((NoiseModel::GtcrnVctk.ladspa_control() - 1.0).abs() < f32::EPSILON);
     }
+
+    #[test]
+    fn automatic_mic_level_default_keeps_headroom_and_manual_opt_in() {
+        let config = AutoMicLevelConfig::default();
+        assert!(!config.enabled);
+        assert_eq!(config.target_dbfs, -12.0);
+        assert!((AUTO_MIC_TARGET_DBFS_MIN..=AUTO_MIC_TARGET_DBFS_MAX)
