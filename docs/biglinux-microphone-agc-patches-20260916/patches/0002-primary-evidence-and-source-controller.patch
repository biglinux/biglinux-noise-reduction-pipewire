+use super::*;
+
+const DT: f64 = 0.05;
+
+fn background(fx: &mut FeatureExtractor, level: f64) {
+    for _ in 0..40 { fx.observe(level, 0.0, DT); }
+}
+
+fn voice_peak(i: usize, high: f64) -> f64 {
+    high + [-6.0, -3.0, 0.0, -3.0][(i / 3) % 4]
+}
+
+fn learn(fx: &mut FeatureExtractor, high: f64) -> Features {
+    let mut last = fx.observe(high - 6.0, 0.0, DT);
+    for i in 0..100 { last = fx.observe(voice_peak(i, high), 0.0, DT); }
+    assert_eq!(last.speech_probability, 1.0);
+    last
+}
+
+#[test]
+fn requires_sustained_modulated_evidence_not_one_peak() {
+    let mut fx = FeatureExtractor::new();
+    background(&mut fx, -90.0);
+    assert_eq!(fx.observe(-25.0, 0.0, DT).speech_probability, 0.0);
+    assert!(fx.primary_dbfs().is_none());
+    let learned = learn(&mut fx, -40.0);
+    assert!((learned.speech_dbfs + 40.0).abs() < 0.01);
+}
+
+#[test]
+fn constant_noise_and_step_noise_do_not_acquire() {
+    let mut fx = FeatureExtractor::new();
+    for _ in 0..200 { assert_eq!(fx.observe(-70.0, 0.0, DT).speech_probability, 0.0); }
+    for _ in 0..12000 { assert_eq!(fx.observe(-35.0, 0.0, DT).speech_probability, 0.0); }
+    assert!(fx.primary_dbfs().is_none());
+}
+
+#[test]
+fn stationary_small_jitter_is_not_speech_evidence() {
+    let mut fx = FeatureExtractor::new();
+    background(&mut fx, -80.0);
+    for i in 0..4000 {
+        let peak = -45.0 + [-0.7, 0.3, 0.7, -0.2][i % 4];
+        assert_eq!(fx.observe(peak, 0.0, DT).speech_probability, 0.0);
+    }
+    assert!(fx.primary_dbfs().is_none());
+}
+
+#[test]
+fn much_quieter_speech_cannot_take_over_after_ten_minutes() {
+    let mut fx = FeatureExtractor::new();
+    background(&mut fx, -95.0);
+    learn(&mut fx, -25.0);
+    let anchor = fx.primary_dbfs();
+    for i in 0..12000 {
+        let feature = fx.observe(voice_peak(i, -50.0), 0.0, DT);
+        assert_eq!(feature.speech_probability, 0.0, "frame {i}");
+        assert_eq!(fx.primary_dbfs(), anchor);
+    }
+}
+
+#[test]
+fn pause_preserves_reference_but_never_authorizes_boost() {
+    let mut fx = FeatureExtractor::new();
+    background(&mut fx, -85.0);
+    learn(&mut fx, -30.0);
+    let anchor = fx.primary_dbfs();
+    let gap = fx.observe(-85.0, 0.0, DT);
+    assert_eq!(gap.speech_probability, 0.0);
+    assert!(gap.snr_db < 1.0);
+    assert_eq!(fx.primary_dbfs(), anchor);
+}
+
+#[test]
+fn sensitivity_offsets_do_not_change_authorization() {
+    for offset in [-20.0, 0.0, 20.0] {
+        let mut fx = FeatureExtractor::new();
+        background(&mut fx, -80.0 + offset);
+        let f = learn(&mut fx, -40.0 + offset);
+        assert!((f.speech_dbfs - (-40.0 + offset)).abs() < 1e-8);
+        assert!((f.snr_db - 40.0).abs() < 6.01);
+    }
+}
+
+#[test]
+fn normalize_before_history_even_when_volume_changes() {
+    let mut fixed = FeatureExtractor::new();
+    let mut varying = FeatureExtractor::new();
+    for i in 0..600 {
+        let gain = if i < 150 { 0.0 } else if i < 350 { 28.0 } else { -5.0 };
+        let peak = if i < 40 || i % 80 > 65 { -90.0 } else { voice_peak(i, -40.0) };
+        let a = fixed.observe(peak, 0.0, DT);
+        let b = varying.observe(peak + gain, gain, DT);
+        assert_eq!(a.speech_probability, b.speech_probability);
+        assert!((a.noise_dbfs - b.noise_dbfs).abs() < 1e-8);
+        assert!((a.speech_dbfs - b.speech_dbfs).abs() < 1e-8);
+    }
+}
+
+#[test]
+fn censored_noise_is_a_finite_bound_and_zero_never_authorizes_boost() {
+    let mut fx = FeatureExtractor::new();
+    for _ in 0..400 {
+        let f = fx.observe(-120.0, 0.0, DT);
+        assert!(!f.muted); // Silence and an explicitly muted source are different.
+        assert_eq!(f.speech_probability, 0.0);
+        assert_eq!(f.noise_dbfs, -120.0);
+    }
+    assert!(fx.noise_is_upper_bound());
+    assert!(fx.primary_dbfs().is_none());
+    // Real, measurable modulated speech can now enroll. This avoids a blind
+    // startup volume jump on a mic whose noise falls below the analyzer floor.
+    learn(&mut fx, -65.0);
+}
+
+#[test]
+fn actual_source_mute_does_not_supply_calibration_evidence() {
+    let mut fx = FeatureExtractor::new();
+    for _ in 0..400 { assert!(fx.source_muted().muted); }
+    assert!(fx.noise_floor.is_none());
+    assert_eq!(fx.background_s, 0.0);
+    assert!(fx.evidence.is_empty());
+}
+
+#[test]
+fn valid_measured_level_can_normalize_below_the_analyzer_floor() {
+    let mut fx = FeatureExtractor::new();
+    let f = fx.observe(-110.0, 28.0, DT);
+    assert!(!f.muted);
+    assert!((f.noise_dbfs + 138.0).abs() < 1e-8);
+}
+
+#[test]
+fn interrupt_and_rebase_preserve_identity_not_stale_evidence() {
+    let mut fx = FeatureExtractor::new();
+    background(&mut fx, -90.0);
+    learn(&mut fx, -35.0);
+    fx.interrupt();
+    assert_eq!(fx.primary_dbfs(), Some(-35.0));
+    assert!(fx.evidence.is_empty());
+    fx.rebase(8.0);
+    assert_eq!(fx.primary_dbfs(), Some(-27.0));
+    background(&mut fx, -82.0);
+    for i in 0..1200 {
+        assert_eq!(fx.observe(voice_peak(i, -52.0), 0.0, DT).speech_probability, 0.0);
+    }
+}
+
+#[test]
+fn invalid_input_is_fail_closed_and_history_is_bounded() {
+    let mut fx = FeatureExtractor::new();
+    for (peak, gain, dt) in [
+        (f64::NAN, 0.0, DT), (-40.0, f64::INFINITY, DT),
+        (-40.0, 0.0, 5.0), (-40.0, 0.0, 0.0), (-40.0, 0.0, f64::NAN),
+    ] {
+        let f = fx.observe(peak, gain, dt);
+        assert!(f.discontinuity);
+        assert_eq!(f.speech_probability, 0.0);
+    }
+    background(&mut fx, -90.0);
+    for i in 0..20000 { fx.observe(voice_peak(i, -35.0), 0.0, 0.001); }
+    assert!(fx.evidence.len() <= FeatureExtractor::MAX_OBSERVATIONS);
+}
+
+#[test]
+fn known_limit_identical_owner_and_tv_observations_get_identical_decisions() {
+    // This is an explicit counterexample to a universal cold-start TV rejection
+    // claim, not a claim that a level-only heuristic recognizes the owner's voice.
+    let mut owner = FeatureExtractor::new();
+    let mut television = FeatureExtractor::new();
+    background(&mut owner, -90.0);
+    background(&mut television, -90.0);
+    for i in 0..200 {
+        let a = owner.observe(voice_peak(i, -35.0), 0.0, DT);
+        let b = television.observe(voice_peak(i, -35.0), 0.0, DT);
+        assert_eq!(a.speech_probability, b.speech_probability);
+        assert_eq!(a.speech_dbfs, b.speech_dbfs);
+    }
+    assert!(owner.primary_dbfs().is_some());
+    assert_eq!(owner.primary_dbfs(), television.primary_dbfs());
+}
