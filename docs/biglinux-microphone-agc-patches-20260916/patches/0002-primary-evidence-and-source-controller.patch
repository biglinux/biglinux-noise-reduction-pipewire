+//! Conservative, relative level evidence for an off-RT gain controller.
+//!
+//! This is NOT a speaker recognizer or a calibrated VAD. A television and a
+//! microphone owner producing the same observations cannot be distinguished here.
+//! Once learned, a quieter source must never take over merely by waiting.
+
+use std::collections::VecDeque;
+
+use crate::gain_policy::Features;
+
+#[derive(Clone, Copy)]
+struct Observation {
+    at: f64,
+    level: f64,
+    weight: f64,
+}
+
+pub(super) struct FeatureExtractor {
+    clock: f64,
+    noise_floor: Option<f64>,
+    noise_is_bound: bool,
+    background_s: f64,
+    primary: Option<f64>,
+    evidence: VecDeque<Observation>,
+    scratch: Vec<(f64, f64)>,
+    flat_level: Option<f64>,
+    flat_s: f64,
+}
+
+impl FeatureExtractor {
+    const WINDOW_S: f64 = 2.4;
+    const EVIDENCE_S: f64 = 1.2;
+    const BACKGROUND_S: f64 = 0.5;
+    const ACQUIRE_CONTRAST_DB: f64 = 18.0;
+    const TRACK_CONTRAST_DB: f64 = 12.0;
+    const PRIMARY_MARGIN_DB: f64 = 10.0;
+    const MODULATION_DB: f64 = 3.0;
+    const MAX_OBSERVATIONS: usize = 256;
+
+    pub(super) fn new() -> Self {
+        Self {
+            clock: 0.0,
+            noise_floor: None,
+            noise_is_bound: false,
+            background_s: 0.0,
+            primary: None,
+            evidence: VecDeque::with_capacity(Self::MAX_OBSERVATIONS),
+            scratch: Vec::with_capacity(Self::MAX_OBSERVATIONS),
+            flat_level: None,
+            flat_s: 0.0,
+        }
+    }
+
+    pub(super) fn primary_dbfs(&self) -> Option<f64> {
+        self.primary
+    }
+
+    pub(super) fn noise_is_upper_bound(&self) -> bool { self.noise_is_bound }
+
+    pub(super) fn source_muted(&mut self) -> Features {
+        self.interrupt();
+        self.untrusted(true, false)
+    }
+
+    /// Missing audio is not silence and does not identify a new speaker. Preserve
+    /// the anchor, but require fresh background/evidence after a capture restart.
+    pub(super) fn interrupt(&mut self) {
+        self.noise_floor = None;
+        self.noise_is_bound = false;
+        self.background_s = 0.0;
+        self.evidence.clear();
+        self.flat_level = None;
+        self.flat_s = 0.0;
+    }
+
+    /// Changing the normalization baseline changes coordinates, not the speaker.
+    pub(super) fn rebase(&mut self, delta_db: f64) {
+        if !delta_db.is_finite() {
+            self.interrupt();
+            return;
+        }
+        self.noise_floor = self.noise_floor.map(|v| v + delta_db);
+        self.primary = self.primary.map(|v| v + delta_db);
+        self.flat_level = self.flat_level.map(|v| v + delta_db);
+        for sample in &mut self.evidence {
+            sample.level += delta_db;
+        }
+    }
+
+    fn untrusted(&self, muted: bool, discontinuity: bool) -> Features {
+        // These finite placeholders carry NO evidence and cannot authorize boost.
+        let floor = self.noise_floor.unwrap_or(-120.0);
+        Features {
+            speech_dbfs: self.primary.unwrap_or(floor),
+            noise_dbfs: floor,
+            raw_clip_fraction: 0.0,
+            speech_probability: 0.0,
+            snr_db: 0.0,
+            muted,
+            far_end_only: false,
+            unreliable_double_talk: false,
+            discontinuity,
+        }
+    }
+
+    /// Input is the raw source's post-volume sample peak, NOT the denoised meter.
+    /// Normalize BEFORE updating any history. `dt` is observed audio time (seconds),
+    /// never the time spent waiting for a stopped producer. Called at ~20 Hz.
+    pub(super) fn observe(&mut self, measured_peak: f64, applied_gain: f64, dt: f64) -> Features {
+        if !measured_peak.is_finite() || !applied_gain.is_finite()
+            || !(dt > 0.0 && dt <= 0.1)
+        {
+            self.interrupt();
+            return self.untrusted(false, true);
+        }
+        self.clock += dt;
+        while self.evidence.front().is_some_and(|s| self.clock - s.at > Self::WINDOW_S) {
+            self.evidence.pop_front();
+        }
+        // Test the analyzer floor BEFORE subtracting gain: -110 measured with +28
+        // gain is valid -138 at baseline. On a genuinely raw source, <= -120 means
+        // censored data: an UPPER BOUND on the noise, not -infinity or a mute flag.
+        // This permits a quiet mic with measurable speech to calibrate without an
+        // unconditional startup boost. Zero itself NEVER authorizes a gain rise.
+        // A post-denoiser/gated stream cannot supply this raw-noise bound.
+        if measured_peak <= -120.0 {
+            let bound = -120.0 - applied_gain;
+            self.noise_floor = Some(self.noise_floor.map_or(bound, |old| old.max(bound)));
+            self.noise_is_bound = true;
+            self.background_s = (self.background_s + dt).min(Self::BACKGROUND_S);
+            self.flat_level = None;
+            self.flat_s = 0.0;
+            return self.untrusted(false, false);
+        }
+        let peak = measured_peak - applied_gain;
+        if !peak.is_finite() {
+            self.interrupt();
+            return self.untrusted(false, true);
+        }
+        let mut floor = *self.noise_floor.get_or_insert(peak);
+        if peak < floor {
+            self.noise_is_bound = false;
+            floor += (peak - floor) * (1.0 - (-dt / 0.15).exp());
+        }
+        let contrast = peak - floor;
+        if contrast < Self::TRACK_CONTRAST_DB {
+            self.noise_is_bound = false;
+            self.background_s = (self.background_s + dt).min(Self::BACKGROUND_S);
+        }
+        if self.flat_level.is_some_and(|v| (peak - v).abs() <= 1.0) {
+            self.flat_s += dt;
+        } else {
+            self.flat_level = Some(peak);
+            self.flat_s = dt;
+        }
+        // Track a new steady fan eventually, but do not immediately absorb a
+        // speech onset into the noise estimate. This is a peak-contrast proxy,
+        // not a physical speech/noise power decomposition.
+        if peak > floor
+            && (contrast < Self::TRACK_CONTRAST_DB || self.flat_s >= Self::WINDOW_S)
+        {
+            floor += (peak - floor) * (1.0 - (-dt / 10.0).exp());
+        }
+        self.noise_floor = Some(floor);
+        let contrast = peak - floor;
+        let threshold = if self.primary.is_some() {
+            Self::TRACK_CONTRAST_DB
+        } else {
+            Self::ACQUIRE_CONTRAST_DB
+        };
+        let eligible = self.background_s >= Self::BACKGROUND_S - 1e-9
+            && contrast >= threshold
+            && self.primary.is_none_or(|p| peak >= p - Self::PRIMARY_MARGIN_DB);
+        if eligible {
+            // Bounded storage even with an unexpectedly high-rate caller. Do not
+            // invent evidence when the bounded history covers too little time.
+            if self.evidence.len() == Self::MAX_OBSERVATIONS {
+                self.evidence.pop_front();
+            }
+            self.evidence.push_back(Observation { at: self.clock, level: peak, weight: dt });
+        }
+        self.scratch.clear();
+        self.scratch.extend(self.evidence.iter().map(|s| (s.level, s.weight)));
+        self.scratch.sort_unstable_by(|a, b| a.0.total_cmp(&b.0));
+        let duration: f64 = self.scratch.iter().map(|s| s.1).sum();
+        let low = weighted_quantile(&self.scratch, duration, 0.2);
+        let high = weighted_quantile(&self.scratch, duration, 0.8);
+        let shaped = duration >= Self::EVIDENCE_S - 1e-9
+            && high.zip(low).is_some_and(|(h, l)| h - l >= Self::MODULATION_DB);
+        let trusted = eligible && shaped;
+        if trusted {
+            if let Some(level) = high {
+                // No downward leak. A cough cannot install an anchor without
+                // sustained evidence; an absent owner cannot be replaced by time.
+                self.primary = Some(self.primary.map_or(level, |old| old.max(level)));
+            }
+        }
+        Features {
+            speech_dbfs: self.primary.unwrap_or(peak),
+            noise_dbfs: floor,
+            // Post-volume peaks cannot prove clipping at the ADC.
+            raw_clip_fraction: 0.0,
+            // Boolean authorization score, not a calibrated P(speech).
+            speech_probability: if trusted { 1.0 } else { 0.0 },
+            // Use CURRENT contrast, never an old loud envelope during a pause.
+            snr_db: contrast,
+            muted: false,
+            far_end_only: false,
+            unreliable_double_talk: false,
+            discontinuity: false,
+        }
+    }
+}
+
+fn weighted_quantile(sorted: &[(f64, f64)], total: f64, fraction: f64) -> Option<f64> {
+    if sorted.is_empty() {
+        return None;
+    }
+    let mut sum = 0.0;
+    for &(level, weight) in sorted {
+        sum += weight;
+        if sum >= total * fraction {
+            return Some(level);
+        }
+    }
+    sorted.last().map(|s| s.0)
+}
+
+#[cfg(test)]
+#[path = "features_tests.rs"]
+mod tests;
