diff --git a/app/tests/test_cli_calibration.py b/app/tests/test_cli_calibration.py
new file mode 100644
index 0000000..98fefff
--- /dev/null
+++ b/app/tests/test_cli_calibration.py
@@ -0,0 +1,43 @@
+"""Backend exit status must take precedence over an optimistic JSON report."""
+import json
+from subprocess import CompletedProcess
+from unittest.mock import patch
+
+import pytest
+from biglinux_microphone import cli
+
+
+def outcome(**changes):
+    return {"heard_speech": True, "volume": 1.25, "device": "mic", **changes}
+
+
+def invoke(result, code=0, stderr=""):
+    completed = CompletedProcess([], code, json.dumps(result), stderr)
+    with patch.object(cli.shutil, "which", return_value="/bin/backend"), patch.object(cli, "_command", return_value=completed):
+        return cli.calibrate()
+
+
+def test_measurement_with_failed_save_is_not_success():
+    with pytest.raises(cli.BackendError, match="read-only"):
+        invoke(outcome(), 1, "settings are read-only")
+
+
+def test_no_speech_is_a_valid_nonzero_outcome():
+    assert invoke(outcome(heard_speech=False), 1)["heard_speech"] is False
+
+
+def test_saved_measurement_is_accepted():
+    assert invoke(outcome())["volume"] == 1.25
+
+
+@pytest.mark.parametrize("changes", [
+    {"heard_speech": 1}, {"volume": True}, {"volume": -1},
+    {"volume": 3.1}, {"device": ""}, {"device": None}, {"volume": float("nan")},
+])
+def test_invalid_report_is_rejected(changes):
+    with pytest.raises(cli.BackendError): invoke(outcome(**changes))
+
+
+@pytest.mark.parametrize("low,high", [(True, 100), (0, True), (0.5, 100), (-1, 100), (2, 1)])
+def test_level_range_rejects_non_integer_and_invalid_percentages(low, high):
+    with pytest.raises(cli.BackendError): cli.set_level_range(low, high)
