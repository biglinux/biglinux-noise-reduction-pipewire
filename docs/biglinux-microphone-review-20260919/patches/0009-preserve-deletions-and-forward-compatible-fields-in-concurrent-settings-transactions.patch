+// Absence is not JSON null. A local deletion must survive an unrelated remote
+// edit, but deleting a remotely edited entry is a genuine three-way conflict.
+fn merge_entry(base: Option<&Value>, local: Option<&Value>, remote: Option<&Value>, path: &str)
+    -> io::Result<Option<Value>> {
+    if local == base { return Ok(remote.cloned()); }
+    if remote == base || remote == local { return Ok(local.cloned()); }
+    if let (Some(base), Some(local), Some(remote)) = (
+        base.and_then(Value::as_object), local.and_then(Value::as_object), remote.and_then(Value::as_object)) {
+        let keys: std::collections::BTreeSet<_> = base.keys().chain(local.keys()).chain(remote.keys()).collect();
+        let mut merged = serde_json::Map::new();
+        for key in keys {
+            if let Some(value) = merge_entry(base.get(key), local.get(key), remote.get(key), &format!("{path}.{key}"))? {
+                merged.insert(key.clone(), value);
+            }
         }
-        return Ok(Value::Object(merged));
+        return Ok(Some(Value::Object(merged)));
     }
-    Err(io::Error::new(
-        io::ErrorKind::WouldBlock,
-        format!("{path} changed in another application. Reload the settings before trying again."),
-    ))
+    Err(io::Error::new(io::ErrorKind::WouldBlock,
+        format!("{path} changed in another application. Reload the settings before trying again.")))
 }
 
