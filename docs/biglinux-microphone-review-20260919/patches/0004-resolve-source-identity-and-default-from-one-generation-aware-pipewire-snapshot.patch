+
+/// One coherent JSON snapshot replaces two unrelated process snapshots. The
+/// metadata selector rejects ambiguous defaults; a node without generation
+/// information can be displayed but cannot authorize an AGC write.
+fn sources_from_graph(graph: &[serde_json::Value]) -> (Vec<Source>, Option<u32>) {
+    let mut cores = graph.iter().filter(|o| o["type"] == "PipeWire:Interface:Core");
+    let cookie = cores.next().and_then(|o| o["info"]["cookie"].as_u64())
+        .and_then(|n| u32::try_from(n).ok());
+    let cookie = if cores.next().is_none() { cookie } else { None };
+    let refs: Vec<_> = graph.iter().collect();
+    let default = crate::services::echo::default_name(&refs, "default.audio.source");
+    let mut sources = Vec::new();
+    for node in graph.iter().filter(|o| o["type"] == "PipeWire:Interface:Node") {
+        let props = &node["info"]["props"];
+        let Some(name) = props["node.name"].as_str().filter(|n| !n.is_empty()) else { continue };
+        if props["media.class"] != "Audio/Source" || is_virtual_source(name) { continue; }
+        let Some(id) = node["id"].as_u64().and_then(|n| u32::try_from(n).ok()) else { continue };
+        let serial = props["object.serial"].as_u64().map(|n| n.to_string())
+            .or_else(|| props["object.serial"].as_str().and_then(|s| s.parse::<u64>().ok()).map(|n| n.to_string()));
+        let description = props["node.description"].as_str().filter(|s| !s.is_empty())
+            .or_else(|| props["node.nick"].as_str().filter(|s| !s.is_empty())).unwrap_or(name);
+        sources.push(Source { node_id: id, node_name: name.to_owned(), description: description.to_owned(),
+            object_serial: serial, core_cookie: cookie });
+    }
+    let mut matches = sources.iter().filter(|s| Some(s.node_name.as_str()) == default.as_deref());
+    let first = matches.next().map(|s| s.node_id);
+    let default_id = if matches.next().is_none() { first } else { None };
     (sources, default_id)
 }
 
