     pub tilt_db: f32,
     /// True when the filter chain's output was the signal measured.
     pub metered_filtered: bool,
@@ -290,7 +291,7 @@ impl VoiceProfile {
     /// Could this frame be the voice the calibration measured?
     #[must_use]
     pub fn admits(&self, dbfs: f32, tilt_db: f32) -> bool {
-        dbfs >= self.floor_dbfs && (self.tilt_low_db..=self.tilt_high_db).contains(&tilt_db)
+        dbfs.is_finite() && tilt_db.is_finite() && dbfs >= self.floor_dbfs && (self.tilt_low_db..=self.tilt_high_db).contains(&tilt_db)
     }
 }
 
