+//! A calibration owns the actuator for the whole pass, not the settings lock.
+//! It shares the daemon's controller/ACK path; silence never causes a blind lift.
+use super::*;
+use super::session::{actuator_lock, FrameClock, read_owned, same_meter, write_owned, WriteResult};
+use crate::services::pipewire::SourceWatch;
+
+const NO_AUDIO_TIMEOUT: Duration = Duration::from_secs(3);
+
+/// Listen for a bounded duration, with a bounded grace period while converging.
+pub fn calibrate(seconds: f64) -> Result<Outcome, String> {
+    if !seconds.is_finite() || seconds <= 0.0 || seconds > 60.0 {
+        return Err("calibration duration must be finite and in (0, 60] seconds".into());
+    }
+    let _owner = actuator_lock(Duration::from_secs(4)).map_err(|e| e.to_string())?;
+    let watch = SourceWatch::start()?;
+    let source = watch.default_source().ok_or("no unambiguous real default microphone")?;
+    let meter = watch.meter_source(&source).ok_or("no unambiguous microphone meter")?;
+    let (entry_volume, muted) = read_owned(&source, &watch)?;
+    if muted || entry_volume == 0.0 { return Err("the microphone is muted or at zero volume".into()); }
+    let settings = AppSettings::load_strict().map_err(|e| e.to_string())?;
+    let mut controller = SourceController::for_calibration(entry_volume,
+        f64::from(CALIBRATION_TARGET_DBFS), noise_ceiling(&settings))?;
+    let base_db = controller.applied_db();
+    let metered_filtered = meter.node_name != source.node_name;
+    let config = agc_monitor_config(meter.object_serial.clone().ok_or("meter serial unavailable")?);
+    let analyzer = config.analyzer.clone();
+    let hop_s = config.hop_size as f64 / f64::from(config.analyzer.sample_rate);
+    let monitor = AudioMonitor::start(config);
+    let events = monitor.events();
+    let started = Instant::now();
+    let deadline = started + Duration::from_secs_f64(seconds);
+    let hard_deadline = deadline + PASS_GRACE;
+    let mut expected = Some(entry_volume);
+    let mut attempted_write = false;
+    let mut clock = FrameClock::default();
+    let mut voiced_s = 0.0;
+    let mut speech_dbfs = None;
+    let mut noise_dbfs = -120.0;
+    let (mut tilt_sum, mut tilt_n) = (0.0, 0_u32);
+    let mut last_audio = started;
+    let mut last_poll = started;
+    let mut last_write: Option<Instant> = None;
+    let mut settled_since: Option<Instant> = None;
+    monitor.set_active(true);
+    let result = (|| -> Result<(), String> {
+        loop {
+            let tick = Instant::now();
+            // Deadlines run on *all* paths, including Empty/Recovering events.
+            if tick >= hard_deadline || (tick >= deadline && voiced_s < HEARD_SPEECH_S) { break; }
+            if last_audio.elapsed() >= NO_AUDIO_TIMEOUT { return Err("microphone audio stalled for 3 seconds".into()); }
+            if !same_meter(&watch, &source, &meter) { return Err("microphone or meter changed during calibration".into()); }
+            if last_poll.elapsed() >= SOURCE_POLL {
+                last_poll = Instant::now();
+                let (actual, muted) = read_owned(&source, &watch)?;
+                if muted || expected.is_none_or(|volume| volume_changed(actual, volume)) {
+                    expected = None; return Err("microphone volume or mute changed outside calibration".into());
+                }
+            }
+            match events.try_recv() {
+                Ok(Event::Frame(frame)) => {
+                    if let Some((dt, discontinuity)) = clock.take(&frame, hop_s, Instant::now()) {
+                        last_audio = Instant::now();
+                        if discontinuity { controller.interrupt(); settled_since = None; }
+                        let step = controller.observe(f64::from(frame.peak_db), dt, false, true)?;
+                        noise_dbfs = step.features.noise_dbfs;
+                        let trusted = step.features.speech_probability >= 0.8 && step.features.snr_db >= 10.0
+                            && matches!(step.decision.state, "tracking_speech" | "peak_safety");
+                        if trusted {
+                            // Never count missing audio as additional observed speech.
+                            voiced_s += hop_s;
+                            speech_dbfs = Some(step.features.speech_dbfs);
+                            if let Some(tilt) = tilt_db(&frame, &analyzer) { tilt_sum += tilt; tilt_n += 1; }
+                        }
+                        let mut wrote = false;
+                        if let Some(requested) = step.requested_volume
+                            && last_write.is_none_or(|at| at.elapsed() >= WRITE_INTERVAL) {
+                                // An error/unknown ACK makes restoration unsafe; never
+                                // guess that a command which timed out did not execute.
+                                attempted_write = true; expected = None;
+                                let status = write_owned(&source, &meter, &watch, &mut controller, requested)?;
+                                if status != WriteResult::Applied { return Err("external volume/mute change interrupted calibration".into()); }
+                                expected = Some(controller.applied_volume());
+                                wrote = true; last_write = Some(Instant::now()); clock.after_write();
+                            }
+                        if wrote || !trusted || step.requested_volume.is_some() { settled_since = None; }
+                        else { settled_since.get_or_insert_with(Instant::now); }
+                        if voiced_s >= HEARD_SPEECH_S && started.elapsed() >= MIN_LISTEN
+                            && settled_since.is_some_and(|at| at.elapsed() >= SETTLED_FOR) { break; }
+                    }
+                }
+                Ok(Event::Recovering(message)) => { controller.interrupt(); clock.reset(); debug!("level: {message}"); }
+                Ok(Event::Fatal(message)) => return Err(format!("monitor failed: {message}")),
+                Err(async_channel::TryRecvError::Closed) => return Err("the level monitor stopped".into()),
+                Err(async_channel::TryRecvError::Empty) => {}
+            }
+            std::thread::sleep(TICK.saturating_sub(tick.elapsed()));
+        }
+        // Final readback too: a late external change is not a calibration result.
+        let (actual, muted) = read_owned(&source, &watch)?;
+        if muted || expected.is_none_or(|volume| volume_changed(actual, volume)) {
+            expected = None; return Err("microphone changed before calibration completed".into());
+        }
+        Ok(())
+    })();
+    // Synchronous teardown on success AND every error path.
+    monitor.shutdown();
+    let heard_speech = voiced_s >= HEARD_SPEECH_S;
+    let needs_restore = result.is_err() || !heard_speech;
+    let restored = if needs_restore && attempted_write {
+        restore(&source, &watch, entry_volume, expected)
+    } else { Ok(false) };
+    if let Err(error) = result {
+        return Err(match restored {
+            Ok(true) => format!("{error}; initial volume restored and verified"),
+            Ok(false) => error,
+            Err(restore_error) => format!("{error}; initial volume NOT restored: {restore_error}"),
+        });
+    }
+    let volume_restored = restored?;
+    let voice = (heard_speech && tilt_n > 0).then(|| speech_dbfs.map(|level| VoiceEvidence {
+        dbfs: (level - base_db) as f32, tilt_db: (tilt_sum / f64::from(tilt_n)) as f32, metered_filtered,
+    })).flatten();
+    Ok(Outcome { device: source.node_name, description: source.description,
+        volume: if heard_speech { controller.applied_volume() } else { entry_volume },
+        speech_dbfs, noise_dbfs, heard_speech, volume_restored, voice })
+}
+
+fn restore(source: &Source, watch: &SourceWatch, entry: f32, expected: Option<f32>) -> Result<bool, String> {
+    let expected = expected.ok_or("last applied volume is unknown; preserving external ownership")?;
+    let (actual, muted) = read_owned(source, watch)?;
+    if muted || volume_changed(actual, expected) { return Err("volume/mute changed outside calibration".into()); }
+    if !volume_changed(actual, entry) { return Ok(false); }
+    set_source_volume(source.node_id, entry).map_err(|e| e.to_string())?;
+    let (actual, muted) = read_owned(source, watch)?;
+    if muted || volume_changed(actual, entry) { return Err("restoration readback did not confirm initial volume".into()); }
+    Ok(true)
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn invalid_duration_is_rejected_before_any_io() {
+        for seconds in [f64::NAN, f64::INFINITY, 0.0, -1.0, 61.0] {
+            assert!(super::calibrate(seconds).unwrap_err().contains("duration"));
+        }
+    }
+}
