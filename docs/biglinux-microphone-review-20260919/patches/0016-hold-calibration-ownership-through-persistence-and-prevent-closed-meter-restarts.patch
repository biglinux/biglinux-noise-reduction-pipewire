@@ -6,8 +6,20 @@ use crate::services::pipewire::SourceWatch;
 
 const NO_AUDIO_TIMEOUT: Duration = Duration::from_secs(3);
 
-/// Listen for a bounded duration, with a bounded grace period while converging.
+/// Retains exclusive actuator ownership until the caller has persisted the
+/// outcome. Dropping this value releases the lease; no audio worker remains.
+pub struct CompletedCalibration {
+    pub outcome: Outcome,
+    _owner: crate::config::storage::SettingsLock,
+}
+
+/// Compatibility API for callers that only need a measurement.
 pub fn calibrate(seconds: f64) -> Result<Outcome, String> {
+    calibrate_held(seconds).map(|completed| completed.outcome)
+}
+
+/// Listen for a bounded duration and keep ownership through the caller's save.
+pub fn calibrate_held(seconds: f64) -> Result<CompletedCalibration, String> {
     if !seconds.is_finite() || seconds <= 0.0 || seconds > 60.0 {
         return Err("calibration duration must be finite and in (0, 60] seconds".into());
     }
@@ -120,9 +132,10 @@ pub fn calibrate(seconds: f64) -> Result<Outcome, String> {
     let voice = (heard_speech && tilt_n > 0).then(|| speech_dbfs.map(|level| VoiceEvidence {
         dbfs: (level - base_db) as f32, tilt_db: (tilt_sum / f64::from(tilt_n)) as f32, metered_filtered,
     })).flatten();
-    Ok(Outcome { device: source.node_name, description: source.description,
+    Ok(CompletedCalibration { outcome: Outcome {
+        device: source.node_name, description: source.description,
         volume: if heard_speech { controller.applied_volume() } else { entry_volume },
-        speech_dbfs, noise_dbfs, heard_speech, volume_restored, voice })
+        speech_dbfs, noise_dbfs, heard_speech, volume_restored, voice }, _owner })
 }
 
 fn restore(source: &Source, watch: &SourceWatch, entry: f32, expected: Option<f32>) -> Result<bool, String> {
