# Maintainer: Bruno Goncalves <bigbruno@gmail.com>
# shellcheck shell=bash disable=SC2034,SC2154

pkgname=biglinux-noise-reduction-pipewire
pkgdesc="AI-powered microphone noise reduction with GTK4/libadwaita interface for PipeWire"
# BigLinux rolling-release convention; these are package build identifiers.
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64')
url="https://github.com/biglinux/${pkgname}"
license=('GPL-3.0-or-later')
depends=(
	# Keep the distribution's maintained allocator; do not replace it in CI.
	'jemalloc-gtk-fixed'
	'pipewire>=1.4'
	'wireplumber>=0.5'
	'systemd'
	'gtcrn-ladspa'
	'swh-plugins'
	'gtk4>=4.22'
	'libadwaita>=1.9'
	'libpipewire'
	'glib2'
	'cairo'
	'glibc'
	'gcc-libs'
)
makedepends=(
	# Unversioned on purpose: rustup declares `provides=(rust)` without a
	# version, so a versioned floor here makes makepkg refuse to build on
	# every developer machine that gets its toolchain from rustup. The
	# minimum version lives in rust-toolchain.toml and the MSRV CI job.
	'rust'
	'cargo'
	'gettext'
	'desktop-file-utils'
	'appstream'
	'pkgconf'
	'clang'
	'jemalloc-gtk-fixed'
	# git is required by the remote source URL, rsync by local preparation.
	'git'
	'rsync'
)
optdepends=(
	'inotify-tools: instant Plasma applet sync with the GTK config window'
	'deepfilternet-ladspa: full-band 48 kHz DeepFilterNet3 denoiser (UI exposes it when installed)'
	'plasma-workspace: Plasma 6 system tray applet'
	'qt6-declarative: QML runtime for the Plasma 6 system tray applet'
	'kirigami: Plasma 6 system tray applet styling'
	'libplasma: Plasma 6 system tray applet host'
	'plasma5support: Plasma 6 system tray applet legacy support module'
)
provides=('biglinux-microphone')
conflicts=('biglinux-microphone')
replaces=('biglinux-microphone')
install="${pkgname}.install"

_has_workspace_files() {
	local root="$1"
	[ -f "${root}/Cargo.toml" ] && [ -f "${root}/Cargo.lock" ] &&
		[ -d "${root}/src" ] && [ -d "${root}/po" ]
}

_local_root=""
if [ "${BIGMIC_FORCE_GIT:-0}" != "1" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
	_pkg_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
	if [ -n "${_pkg_dir}" ]; then
		_candidate="$(cd "${_pkg_dir}/../.." && pwd -P)"
		if _has_workspace_files "${_candidate}"; then
			_local_root="${_candidate}"
		fi
		unset _candidate
	fi
fi

if [ -n "${_local_root}" ]; then
	echo "==> Local source detected at ${_local_root} — skipping git fetch" >&2
	source=()
	b2sums=()
else
	echo "==> No local source found, will fetch from ${url}.git" >&2
	source=("git+${url}.git")
	b2sums=('SKIP')
fi

prepare() {
	if [ -z "${_local_root}" ]; then
		return 0
	fi
	# Never fall back to cp -a: the normal makepkg source directory lives
	# inside this checkout, so a recursive copy would copy into itself.
	# Resolve both paths before --delete, including custom SRCDEST layouts.
	local root destination
	local nested_exclusion=()
	root=$(realpath -e -- "${_local_root}") || return 1
	destination=$(realpath -m -- "${srcdir}/${pkgname}") || return 1
	if [[ "$root" == "$destination" || "$root" == "$destination/"* ]]; then
		printf 'Refusing a package source destination containing the checkout: %s\n' "$destination" >&2
		return 1
	fi
	if [[ "$destination" == "$root/"* ]]; then
		nested_exclusion=("--exclude=/${destination#"$root/"}/")
	fi
	command -v rsync >/dev/null || {
		printf 'Missing build dependency: rsync\n' >&2
		return 1
	}
	msg2 "Mirroring local source tree from ${root}"
	mkdir -p "$destination"
	rsync -a --delete \
		--exclude='/target' \
		--exclude='/.git' \
		--exclude='/.ci-results' \
		--exclude='/build-locale' \
		--exclude='/packaging/arch/pkg' \
		--exclude='/packaging/arch/src' \
		--exclude='*.pkg.tar.*' \
		--exclude='*.log' \
		"${nested_exclusion[@]}" \
		"${root}/" "${destination}/"
}

build() {
	cd "${srcdir}/${pkgname}" || exit 1
	cargo build --release --locked

	# The catalog domain must match config::GETTEXT_PACKAGE. Remove only
	# generated catalogs, otherwise a deleted language survives a rebuild.
	local po lang
	rm -rf -- build-locale
	install -d build-locale
	for po in po/*.po; do
		[ -f "$po" ] || continue
		lang=$(basename "$po" .po)
		install -d "build-locale/${lang}/LC_MESSAGES"
		msgfmt --check "$po" -o "build-locale/${lang}/LC_MESSAGES/biglinux-microphone.mo"
	done
}

check() {
	cd "${srcdir}/${pkgname}" || exit 1
	desktop-file-validate usr/share/applications/br.com.biglinux.microphone.desktop
	appstreamcli validate --no-net usr/share/metainfo/br.com.biglinux.microphone.metainfo.xml
	cargo test --release --locked
}

package() {
	cd "${srcdir}/${pkgname}" || exit 1
	local binary mo
	for binary in biglinux-microphone biglinux-microphone-cli biglinux-microphone-probe biglinux-microphone-pwloader; do
		install -Dm755 "target/release/${binary}" "${pkgdir}/usr/bin/${binary}"
	done

	# usr/ is the versioned package payload: units, WirePlumber policy,
	# desktop metadata, icons, Plasma applet and didactic illustrations.
	# Install the complete tree so new resources cannot be omitted by an
	# outdated list of individual install commands.
	install -d "${pkgdir}/usr"
	cp -a usr/. "${pkgdir}/usr/"

	for mo in build-locale/*/LC_MESSAGES/*.mo; do
		[ -f "$mo" ] || continue
		install -Dm644 "$mo" "${pkgdir}/usr/share/${mo#build-}"
	done

	install -Dm644 LICENSE-MIT "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	install -Dm644 docs/guia-rapido.pt_BR.md "${pkgdir}/usr/share/doc/${pkgname}/guia-rapido.pt_BR.md"
}
