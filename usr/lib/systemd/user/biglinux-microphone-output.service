[Unit]
Description=Filter noise — output-side noise-reduction filter (pwloader)
Documentation=https://github.com/biglinux/biglinux-noise-reduction-pipewire
PartOf=pipewire.service
After=pipewire.service wireplumber.service
Requisite=pipewire.service
Wants=pipewire.service wireplumber.service

# The reconciler writes the args file before starting this unit;
# a missing file means "user turned this chain off" and must not
# produce a Restart=on-failure loop.

# Hard-stop a crash loop (e.g. an unloadable LADSPA plugin) after five
# quick failures instead of restarting every 2 s forever; the GUI
# surfaces the failure via its status banner and "Try again" re-runs
# the reconcile after the user fixes the cause.
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
ExecCondition=/usr/bin/biglinux-microphone-pwloader --check-config @config/output.args
Type=simple
# `biglinux-microphone-pwloader` connects to the running PipeWire
# daemon as a regular client and asks it to instantiate
# libpipewire-module-filter-chain inside this process. The daemon
# drives every node, so the output filter shares the system clock
# with the rest of the audio graph — no cross-process drift.
ExecStart=/usr/bin/biglinux-microphone-pwloader libpipewire-module-filter-chain @config/output.args
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

# ── Realtime budget ──────────────────────────────────────────────────
# The graph nodes hosted in this process request RT scheduling via
# libpipewire-module-rt (loaded automatically by the daemon's
# `client.conf`). rtkit grants the priority; the rlimits below let
# the process honour it.
LimitRTPRIO=95
LimitNICE=-19
# The loader uses mlockall(MCL_CURRENT): only mappings existing at that call
# are covered. Later allocations/JIT mappings are not implicitly locked.
# Keep the existing cap pending measurement with the shipped models. This
# resource limit neither proves prefaulting nor makes the callback hard-RT.
LimitMEMLOCK=1G

# ── Hardening ────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
PrivateTmp=true
RestrictNamespaces=true
RestrictRealtime=false
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
