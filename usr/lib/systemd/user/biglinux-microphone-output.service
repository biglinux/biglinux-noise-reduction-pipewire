[Unit]
Description=Filter noise — output-side noise-reduction filter (pwloader)
Documentation=https://github.com/biglinux/biglinux-noise-reduction-pipewire
PartOf=pipewire.service
After=pipewire.service wireplumber.service
Requisite=pipewire.service
Wants=pipewire.service wireplumber.service

# The reconciler writes the args file before starting this unit;
# a missing file means "user turned this chain off" and must not
# produce a Restart=on-failure loop.
ConditionPathExists=%h/.config/biglinux-microphone/output.args

# Hard-stop a crash loop (e.g. an unloadable LADSPA plugin) after five
# quick failures instead of restarting every 2 s forever; the GUI
# surfaces the failure via its status banner and "Try again" re-runs
# the reconcile after the user fixes the cause.
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
# `biglinux-microphone-pwloader` connects to the running PipeWire
# daemon as a regular client and asks it to instantiate
# libpipewire-module-filter-chain inside this process. The daemon
# drives every node, so the output filter shares the system clock
# with the rest of the audio graph — no cross-process drift.
ExecStart=/usr/bin/biglinux-microphone-pwloader libpipewire-module-filter-chain %h/.config/biglinux-microphone/output.args
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

# ── Realtime budget ──────────────────────────────────────────────────
# The graph nodes hosted in this process request RT scheduling via
# libpipewire-module-rt (loaded automatically by the daemon's
# `client.conf`). rtkit grants the priority; the rlimits below let
# the process honour it.
LimitRTPRIO=95
LimitNICE=-19
# Bounded: mlockall(MCL_CURRENT|MCL_FUTURE) in the loader pins every
# mapping the process makes, and the OpenVINO CPU plugin's JIT is by far
# the hungriest of them. Measured with the heaviest model we ship,
# dpdfnet8_48khz_hr: VmLck peaks at 530 MB while compiling. At the old
# 512M cap `compile_model` failed outright and the chain silently passed
# audio through undenoised. 1G keeps real headroom above the measured
# peak while still capping a leak instead of pinning all of RAM.
LimitMEMLOCK=1G

# ── Hardening ────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
PrivateTmp=true
RestrictNamespaces=true
RestrictRealtime=false
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
