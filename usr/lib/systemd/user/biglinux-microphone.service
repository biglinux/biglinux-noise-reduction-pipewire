[Unit]
Description=Filter noise — reconcile PipeWire filter chain with saved settings
Documentation=https://github.com/biglinux/biglinux-noise-reduction-pipewire
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
# No start limit. systemd counts every start, not just the failed ones, and
# biglinux-microphone.path starts this unit on each settings change — so a limit
# sized for a crash loop is reached by somebody simply changing six settings in a
# row, and from then on their edits stop being applied. Runaway triggers are the
# path unit's job (TriggerLimitBurst); a genuinely failing reconcile is bounded
# below by RestartSec instead.
StartLimitIntervalSec=0

[Service]
# Reconcile, then leave. Every long-lived job this used to hold is now owned by
# something that only exists while it is needed: biglinux-microphone.path wakes
# this unit when the settings file changes, and the reconciler starts the AGC and
# the route observer when their features are on. With every filter off, nothing
# of ours stays resident.
Type=oneshot
ExecStart=/usr/bin/biglinux-microphone-cli autostart
# A reconcile can legitimately fail while the graph is still coming up — PipeWire
# not yet accepting clients, the AEC source not visible within its deadline. The
# in-process watcher retried these with a backoff that topped out at 30s; this is
# the same ceiling without a thread alive to hold the timer. Each attempt is short
# and stops as soon as one succeeds.
Restart=on-failure
RestartSec=30s
SuccessExitStatus=0
TimeoutStartSec=30s
StandardOutput=journal
StandardError=journal

# ── Hardening ────────────────────────────────────────────────────────
# Read-only access to /usr and /etc; the tool only writes under
# $HOME/.config so leaving ProtectHome unset is intentional.
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# PipeWire talks over a unix socket; we also need AF_NETLINK for some
# pw-cli error paths that call getifaddrs internally.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
