[Unit]
Description=Filter noise — mic-side filter chain (pwloader)
Documentation=https://github.com/biglinux/biglinux-noise-reduction-pipewire
PartOf=pipewire.service
# `After=` orders the mic loader behind the AEC loader *when both are
# being started*: the AEC source must already exist by the time the
# mic chain resolves `target.object = "echo-cancel-source"`. We
# deliberately do NOT list the AEC unit under `Wants=` though — that
# would make systemd auto-start AEC every time the mic loader starts,
# even if the user has the AEC toggle off. The mic chain only pins
# `echo-cancel-source` when the user explicitly enables AEC; when AEC
# is off it falls back to the hardware mic via WirePlumber's
# follow-default policy and the AEC loader must stay down.
#
# Pre-fix symptom: toggling AEC off while leaving mic on caused the
# state machine to (a) stop AEC, (b) restart the mic unit to drop the
# stale `target.object`, and (c) systemd silently re-pulled AEC up
# through `Wants=` — leaving the AEC pwloader running with a deleted
# args file (and looping under `Restart=on-failure` until any toggle
# briefly recreated the file, after which it stuck around with a
# stale module loaded inside the daemon's context).
After=pipewire.service wireplumber.service biglinux-microphone-aec.service
Wants=pipewire.service wireplumber.service
Requisite=pipewire.service

# The reconciler writes the args file before starting this unit;
# a missing file means "user turned this chain off" and must not
# produce a Restart=on-failure loop.
ConditionPathExists=%h/.config/biglinux-microphone/mic.args

# Hard-stop a crash loop (e.g. an unloadable LADSPA plugin) after five
# quick failures instead of restarting every 2 s forever; the GUI
# surfaces the failure via its status banner and "Try again" re-runs
# the reconcile after the user fixes the cause.
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
# Loads libpipewire-module-filter-chain inside this client process,
# sharing the daemon's clock with every other node in the graph.
ExecStart=/usr/bin/biglinux-microphone-pwloader libpipewire-module-filter-chain %h/.config/biglinux-microphone/mic.args
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

# ── Realtime budget ──────────────────────────────────────────────────
LimitRTPRIO=95
LimitNICE=-19
# Bounded: mlockall(MCL_CURRENT|MCL_FUTURE) in the loader pins every
# mapping the process makes, and the OpenVINO CPU plugin's JIT is by far
# the hungriest of them. Measured with the heaviest model we ship,
# dpdfnet8_48khz_hr: VmLck peaks at 530 MB while compiling. At the old
# 512M cap `compile_model` failed outright and the chain silently passed
# audio through undenoised. 1G keeps real headroom above the measured
# peak while still capping a leak instead of pinning all of RAM.
LimitMEMLOCK=1G

# ── Hardening ────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
PrivateTmp=true
RestrictNamespaces=true
RestrictRealtime=false
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
