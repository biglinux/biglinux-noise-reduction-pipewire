[Unit]
Description=BigLinux Microphone — mic-side filter chain (pwloader)
Documentation=https://github.com/biglinux/biglinux-noise-reduction-pipewire
PartOf=pipewire.service
# AEC source must already exist when the mic chain resolves
# `target.object = "echo-cancel-source"`; ordering against the AEC
# unit covers the AEC-on case without making it mandatory (the chain
# falls back to the hw mic when AEC is off, via WirePlumber's
# follow-default policy).
After=pipewire.service wireplumber.service biglinux-microphone-aec.service
Wants=pipewire.service wireplumber.service biglinux-microphone-aec.service
Requisite=pipewire.service

[Service]
Type=simple
# Loads libpipewire-module-filter-chain inside this client process,
# sharing the daemon's clock with every other node in the graph.
ExecStart=/usr/bin/biglinux-microphone-pwloader libpipewire-module-filter-chain %h/.config/biglinux-microphone/mic.args
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

# ── Realtime budget ──────────────────────────────────────────────────
LimitRTPRIO=95
LimitNICE=-19
LimitMEMLOCK=infinity

# ── Hardening ────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
PrivateTmp=true
RestrictNamespaces=true
RestrictRealtime=false
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
