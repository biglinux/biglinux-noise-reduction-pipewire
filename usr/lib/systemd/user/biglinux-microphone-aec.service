[Unit]
Description=Filter noise — echo cancellation (pwloader)
Documentation=https://github.com/biglinux/biglinux-noise-reduction-pipewire
PartOf=pipewire.service
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
Requisite=pipewire.service

# The reconciler writes the args file before starting this unit;
# a missing file means "user turned this chain off" and must not
# produce a Restart=on-failure loop.

# Hard-stop a crash loop (e.g. an unloadable LADSPA plugin) instead of
# restarting every 2 s forever; the GUI surfaces the failure via its status
# banner and "Try again" re-runs the reconcile after the user fixes the cause.
StartLimitIntervalSec=30
StartLimitBurst=8

[Service]
ExecCondition=/usr/bin/biglinux-microphone-pwloader --check-config @config/aec.args
Type=simple
# Hosts libpipewire-module-echo-cancel inside the loader's client
# context. The cleaned `echo-cancel-source` is exported to the daemon
# and is what the mic chain pins as its capture target when AEC is on.
ExecStart=/usr/bin/biglinux-microphone-pwloader libpipewire-module-echo-cancel @config/aec.args
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

# ── Realtime budget ──────────────────────────────────────────────────
LimitRTPRIO=95
LimitNICE=-19
# The loader uses mlockall(MCL_CURRENT): only mappings existing at that call
# are covered. Later allocations/JIT mappings are not implicitly locked.
# Keep the existing cap pending measurement with the shipped models. This
# resource limit neither proves prefaulting nor makes the callback hard-RT.
LimitMEMLOCK=1G

# ── Hardening ────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
PrivateTmp=true
RestrictNamespaces=true
RestrictRealtime=false
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
