[Unit]
Description=BigLinux Microphone — WebRTC echo-cancellation (pwloader)
Documentation=https://github.com/biglinux/biglinux-noise-reduction-pipewire
PartOf=pipewire.service
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
Requisite=pipewire.service

[Service]
Type=simple
# Hosts libpipewire-module-echo-cancel inside the loader's client
# context. The cleaned `echo-cancel-source` is exported to the daemon
# and is what the mic chain pins as its capture target when AEC is on.
ExecStart=/usr/bin/biglinux-microphone-pwloader libpipewire-module-echo-cancel %h/.config/biglinux-microphone/aec.args
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

# ── Realtime budget ──────────────────────────────────────────────────
LimitRTPRIO=95
LimitNICE=-19
LimitMEMLOCK=infinity

# ── Hardening ────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
PrivateTmp=true
RestrictNamespaces=true
RestrictRealtime=false
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
