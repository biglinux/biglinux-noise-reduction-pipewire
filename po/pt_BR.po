#: app/biglinux_microphone/ui/pages/compare.py:67
msgid ""
"Listen to the short recording and check whether your voice sounds clear and "
"natural."
msgstr "Ouça a gravação e confira se sua voz está clara e natural."

#: app/biglinux_microphone/ui/pages/microphone_test.py:167
#: app/biglinux_microphone/ui/pages/microphone_test.py:371
msgid "Play sample"
msgstr "Reproduzir amostra"

#: app/biglinux_microphone/ui/pages/microphone_test.py:173
msgid "Record again"
msgstr "Gravar novamente"

#: app/biglinux_microphone/ui/pages/microphone_test.py:175
#: app/biglinux_microphone/ui/pages/calibrate.py:202
msgid "Done"
msgstr "Concluir"

#: app/biglinux_microphone/ui/pages/microphone_test.py:195
msgid "I could not record the microphone"
msgstr "Não foi possível gravar o microfone"

#: app/biglinux_microphone/ui/pages/microphone_test.py:196
#: app/biglinux_microphone/ui/pages/microphone_test.py:401
msgid "Check that the microphone is available and try again."
msgstr "Confira se o microfone está disponível e tente novamente."

#: app/biglinux_microphone/ui/pages/microphone_test.py:217
msgid "The microphone changed or became unavailable. Record a new sample."
msgstr "O microfone mudou ou ficou indisponível. Grave uma nova amostra."

#: app/biglinux_microphone/ui/pages/microphone_test.py:236
msgid "The microphone is not ready. Return to Home to check its status."
msgstr ""
"O microfone não está pronto. Volte ao início para verificar o estado dele."

#: app/biglinux_microphone/ui/pages/microphone_test.py:240
msgid "The sample includes the current noise reduction and voice settings."
msgstr "A amostra inclui a redução de ruído e os ajustes de voz atuais."

#: app/biglinux_microphone/ui/pages/microphone_test.py:244
msgid "Noise reduction is off, so the sample uses the microphone directly."
msgstr ""
"A redução de ruído está desligada. A amostra usa o microfone diretamente."

#: app/biglinux_microphone/ui/pages/microphone_test.py:264
#: app/biglinux_microphone/ui/pages/calibrate.py:312
msgid "No microphone is selected"
msgstr "Nenhum microfone selecionado"

#: app/biglinux_microphone/ui/pages/microphone_test.py:371
msgid "Stop playback"
msgstr "Parar reprodução"

#: app/biglinux_microphone/ui/pages/compare.py:27
msgid "Original"
msgstr "Original"

#: app/biglinux_microphone/ui/pages/compare.py:29
msgid "With noise reduction"
msgstr "Com redução de ruído"

#: app/biglinux_microphone/ui/pages/compare.py:41
msgid "Compare the same recording"
msgstr "Compare a mesma gravação"

#: app/biglinux_microphone/ui/pages/compare.py:44
msgid ""
"Speak normally for five seconds. Then listen to the same words with and "
"without noise reduction."
msgstr ""
"Fale normalmente por cinco segundos. Depois, ouça as mesmas palavras com e "
"sem redução de ruído."

#: app/biglinux_microphone/ui/pages/compare.py:48
msgid "Recording your microphone, then preparing both versions…"
msgstr "Gravando seu microfone e preparando as duas versões…"

#: app/biglinux_microphone/ui/pages/compare.py:52
msgid ""
"Choose a version and play it. Playback volumes are balanced for comparison."
msgstr ""
"Escolha uma versão e reproduza. Os volumes são equilibrados para a "
"comparação."

#: app/biglinux_microphone/ui/pages/compare.py:83
msgid ""
"This comparison includes noise reduction only. Equalizer, echo cancellation "
"and other voice effects are not included."
msgstr ""
"Esta comparação inclui apenas a redução de ruído. Equalizador, cancelamento "
"de eco e outros efeitos de voz não estão incluídos."

#: app/biglinux_microphone/ui/pages/compare.py:127
msgid "Play original"
msgstr "Ouvir original"

#: app/biglinux_microphone/ui/pages/compare.py:129
msgid "Play with noise reduction"
msgstr "Ouvir com redução de ruído"

#: app/biglinux_microphone/ui/pages/calibrate.py:66
msgid "Adjust the volume for your voice"
msgstr "Ajuste o volume para sua voz"

#: app/biglinux_microphone/ui/pages/calibrate.py:75
msgid ""
"Speak normally for a few seconds. The program will set the volume for this "
"microphone."
msgstr ""
"Fale normalmente por alguns segundos. O programa ajustará o volume deste "
"microfone."

#: app/biglinux_microphone/ui/pages/calibrate.py:84
msgid "Checking…"
msgstr "Verificando…"

#: app/biglinux_microphone/ui/pages/calibrate.py:93
msgid ""
"Speak at the volume and distance you normally use in calls and recordings."
msgstr ""
"Fale com o volume e a distância que costuma usar em chamadas e gravações."

#: app/biglinux_microphone/ui/pages/calibrate.py:98
msgid "Start"
msgstr "Começar"

#: app/biglinux_microphone/ui/pages/calibrate.py:126
msgid ""
"The program is listening to your voice to set the ideal volume for this "
"microphone."
msgstr "O programa está ouvindo sua voz para ajustar o volume deste microfone."

#: app/biglinux_microphone/ui/pages/calibrate.py:139
#: app/biglinux_microphone/ui/pages/calibrate.py:321
msgid "Listening to your voice"
msgstr "Ouvindo sua voz"

#: app/biglinux_microphone/ui/pages/calibrate.py:152
msgid "Speak at the volume and distance you normally use."
msgstr "Fale com o volume e a distância que costuma usar."

#: app/biglinux_microphone/ui/pages/calibrate.py:179
msgid "Your microphone is adjusted"
msgstr "Seu microfone está ajustado"

#: app/biglinux_microphone/ui/pages/calibrate.py:187
msgid "The volume was set for your voice and this microphone."
msgstr "O volume foi ajustado para sua voz neste microfone."

#: app/biglinux_microphone/ui/pages/calibrate.py:196
msgid "Ready to use"
msgstr "Pronto para usar"

#: app/biglinux_microphone/ui/pages/calibrate.py:197
msgid "You can test your voice or finish now."
msgstr "Você pode testar sua voz ou concluir agora."

#: app/biglinux_microphone/ui/pages/calibrate.py:211
msgid "Adjust again"
msgstr "Ajustar novamente"

#: app/biglinux_microphone/ui/pages/calibrate.py:218
msgid "For live streams and long recordings"
msgstr "Para transmissões ao vivo e gravações longas"

#: app/biglinux_microphone/ui/pages/calibrate.py:221
msgid "Keep voice volume uniform"
msgstr "Manter o volume da voz uniforme"

#: app/biglinux_microphone/ui/pages/calibrate.py:222
msgid "Compensates when you move farther from the microphone."
msgstr "Compensa quando você se afasta do microfone."

#: app/biglinux_microphone/ui/pages/calibrate.py:240
msgid "I could not adjust the microphone"
msgstr "Não foi possível ajustar o microfone"

#: app/biglinux_microphone/ui/pages/calibrate.py:242
msgid ""
"Check that the right microphone is selected and try again while speaking "
"normally."
msgstr ""
"Confira se o microfone certo está selecionado e tente novamente, falando "
"normalmente."

#: app/biglinux_microphone/ui/pages/calibrate.py:287
msgid "Microphone currently selected"
msgstr "Microfone selecionado"

#: app/biglinux_microphone/ui/pages/calibrate.py:350
msgid "Almost done — keep talking"
msgstr "Quase pronto — continue falando"

#: app/biglinux_microphone/ui/pages/calibrate.py:392
msgid "Cancelling…"
msgstr "Cancelando…"

#: app/biglinux_microphone/ui/pages/calibrate.py:417
#, python-format
msgid "Could not fully restore the previous microphone level: %s"
msgstr ""
"Não foi possível restaurar completamente o volume anterior do microfone: %s"

#: app/biglinux_microphone/ui/widgets/threshold_editor.py:218
#, python-format
msgid "%s Hz threshold (dB)"
msgstr "Limiar em %s Hz (dB)"

#: app/biglinux_microphone/ui/widgets/activity_meter.py:55
msgid "Microphone level"
msgstr "Nível do microfone"

#: app/biglinux_microphone/ui/widgets/activity_meter.py:127
#, python-format
msgid "Level: %s dBFS"
msgstr "Nível: %s dBFS"

#: app/biglinux_microphone/ui/widgets/activity_meter.py:128
#, python-format
msgid "Peak: %s dBFS"
msgstr "Pico: %s dBFS"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:58
#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:75
msgid "Could not read the audio status. Open settings to check the connection."
msgstr ""
"Não foi possível verificar o estado do áudio. Abra as configurações para "
"verificar a conexão."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:79
msgid ""
"The change could not be applied. Your previous choices have been kept where "
"possible. Open settings for details."
msgstr ""
"Não foi possível aplicar a alteração. Suas escolhas anteriores foram "
"mantidas quando possível. Abra as configurações para ver os detalhes."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:121
msgid "Microphone and system sound filters"
msgstr "Filtros do microfone e do som do sistema"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:122
msgid "Audio needs attention. Open the controls for details."
msgstr "O áudio precisa de atenção. Abra os controles para ver os detalhes."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:122
msgid "Open audio filter controls"
msgstr "Abrir os controles dos filtros de áudio"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:131
msgid "Filter noise"
msgstr "Filtro de ruído"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:138
msgid "Some audio filters are not ready. Open settings to check them."
msgstr ""
"Alguns filtros de áudio não estão prontos. Abra as configurações para "
"verificá-los."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:144
msgid "Microphone filter"
msgstr "Filtro do microfone"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:146
msgid "Turning this off pauses the effects without erasing your preferences."
msgstr "Desligar pausa os efeitos sem apagar suas preferências."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:153
msgid "Cleans your voice for calls and recordings"
msgstr "Reduz o ruído da sua voz em chamadas e gravações"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:158
msgid "System sound filter"
msgstr "Filtro do som do sistema"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:166
msgid "Applies your selected effects to the sound you hear."
msgstr "Aplica os efeitos escolhidos ao som que você escuta."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:172
msgid "Open settings…"
msgstr "Abrir configurações…"
