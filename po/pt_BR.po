msgstr "Volume mínimo (%)"

#: app/biglinux_microphone/ui/controls.py:357
msgid "Maximum volume (%)"
msgstr "Volume máximo (%)"

#: app/biglinux_microphone/ui/controls.py:366
msgid "Apply volume limits"
msgstr "Aplicar limites de volume"

#: app/biglinux_microphone/ui/controls.py:376
#: app/biglinux_microphone/ui/pages/calibrate.py:32
msgid "Adjust volume"
msgstr "Ajustar volume"

#: app/biglinux_microphone/ui/controls.py:606
msgid "Input disconnected"
msgstr "Entrada desconectada"

#: app/biglinux_microphone/ui/controls.py:608
msgid "These inputs may already apply sound effects."
msgstr "Essas entradas podem já aplicar efeitos ao som."

#: app/biglinux_microphone/ui/controls.py:625
msgid ""
"Connect a microphone. For Bluetooth, enable the headset microphone in your "
"system sound settings."
msgstr ""
"Conecte um microfone. Para Bluetooth, ative o microfone do headset nas "
"configurações de som do sistema."

#: app/biglinux_microphone/ui/controls.py:659
msgid "Noise reduction is off"
msgstr "A redução de ruído está desligada"

#: app/biglinux_microphone/ui/controls.py:723
#, python-format
msgid "Follows your voice between %(low)d%% and %(high)d%%"
msgstr "Acompanha sua voz entre %(low)d%% e %(high)d%%"

#: app/biglinux_microphone/ui/controls.py:731
msgid "Adjusted for your voice"
msgstr "Ajustado para sua voz"

#: app/biglinux_microphone/ui/controls.py:733
msgid "Not adjusted yet — measure once for this microphone"
msgstr "Ainda não ajustado — faça uma medição para este microfone"

