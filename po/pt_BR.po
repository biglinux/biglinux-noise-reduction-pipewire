#: app/biglinux_microphone/ui/pages/noise_reduction.py:27
msgid "DFN3 — recommended"
msgstr "DFN3 — recomendado"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:27
msgid "The lightest. Works well on older computers."
msgstr "O mais leve. Funciona bem em computadores mais antigos."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:32
msgid ""
"A larger network that leaves less noise between words. Uses about twice the "
"processing of DFN3, and has the shortest delay while “Silence when nobody "
"speaks” is off."
msgstr ""
"Uma rede maior, que deixa menos ruído entre as palavras. Usa cerca do dobro "
"do processamento do DFN3 e tem o menor atraso enquanto “Silenciar quando "
"ninguém fala” está desligado."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:41
msgid ""
"The strongest cleanup, with a steady quiet background. Uses about four times "
"the processing of DFN3."
msgstr ""
"A limpeza mais forte, com o fundo sempre silencioso. Usa cerca de quatro "
"vezes o processamento do DFN3."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:67
msgid "Applications hear your voice with less background noise."
msgstr "Os aplicativos recebem sua voz com menos ruído de fundo."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:81
msgid "Heavier models clean more and use more processing."
msgstr "Modelos mais pesados limpam mais e usam mais processamento."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:111
msgid "Silence when nobody speaks"
msgstr "Silenciar quando ninguém fala"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:113
msgid ""
"Mutes leftover noise while you are not talking. Your voice then arrives "
"about 0.07 s later."
msgstr ""
"Silencia o ruído que sobra enquanto você não fala. Sua voz passa a chegar "
"cerca de 0,07 s depois."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:124
msgid "Voice detection"
msgstr "Detecção de voz"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:126
msgid ""
"Sensitive keeps quiet voices and lets more noise through; strict mutes more "
"noise and may cut faint words."
msgstr ""
"A detecção sensível mantém vozes baixas e deixa passar mais ruído; a "
"rigorosa silencia mais ruído e pode cortar palavras ditas em voz baixa."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:134
msgid "Very sensitive"
msgstr "Muito sensível"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:135
msgid "Sensitive"
msgstr "Sensível"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:136
msgid "Normal"
msgstr "Normal"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:137
msgid "Strict"
msgstr "Rigorosa"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:138
msgid "Very strict"
msgstr "Muito rigorosa"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:155
msgid "Intensity"
msgstr "Intensidade"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:163
msgid "How much noise to remove"
msgstr "Quanto ruído remover"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:166
msgid "Lower values preserve more of the original sound."
msgstr "Valores menores preservam mais do som original."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:173
msgid "The current model already handles residual noise internally."
msgstr "O modelo atual já trata os ruídos residuais internamente."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:179
msgid "Noise that still gets through"
msgstr "Ruídos que ainda passam"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:180
msgid "DFN3 can silence very quiet residual sounds between words."
msgstr "O DFN3 pode silenciar ruídos muito baixos entre as palavras."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:183
msgid "Silence residual noise by frequency"
msgstr "Silenciar ruídos residuais por frequência"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:184
msgid "Sounds below the line will be silenced."
msgstr "Os sons abaixo da linha serão silenciados."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:201
msgid "Manual adjustments active"
msgstr "Ajustes manuais ativos"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:203
msgid "Values set on the command line replace the recommended ones for DFN3."
msgstr ""
"Valores definidos pela linha de comando substituem os recomendados para o "
"DFN3."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:206
msgid "Restore"
msgstr "Restaurar"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:225
msgid ""
"Move the line above residual noise, but keep it below the quiet parts of "
"your voice."
msgstr ""
"Mova a linha para cima do ruído residual, mas mantenha-a abaixo dos trechos "
"mais baixos da sua voz."

#: app/biglinux_microphone/ui/pages/noise_reduction.py:235
msgid "Restore recommended"
msgstr "Restaurar o recomendado"

#: app/biglinux_microphone/ui/pages/noise_reduction.py:348
#, python-format
msgid "Model in use: %s"
msgstr "Modelo em uso: %s"

