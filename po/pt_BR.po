#: app/biglinux_microphone/ui/widgets/setting_cards.py:375
msgid "Off"
msgstr "Desligado"

#: app/biglinux_microphone/ui/controls.py:38
msgid "Light filter"
msgstr "Filtro leve"

#: app/biglinux_microphone/ui/controls.py:41
msgid ""
"DFN3: good for most situations, with a clean voice of good quality. The "
"lightest, it works well on older computers."
msgstr ""
"DFN3: bom para a maioria das situações, com a voz limpa e de boa qualidade. "
"É o mais leve e funciona bem em computadores mais antigos."

#: app/biglinux_microphone/ui/controls.py:44
msgid "High quality"
msgstr "Alta qualidade"

#: app/biglinux_microphone/ui/controls.py:47
msgid ""
"DPDFNet: the strongest cleanup, with a steady quiet background. Uses about "
"four times the processing of DFN3."
msgstr ""
"DPDFNet: a limpeza mais forte, com o fundo silencioso e estável. Usa cerca "
"de quatro vezes o processamento do DFN3."

#: app/biglinux_microphone/ui/controls.py:53
msgid "Very sensitive"
msgstr "Muito sensível"

#: app/biglinux_microphone/ui/controls.py:54
msgid "Sensitive"
msgstr "Sensível"

#: app/biglinux_microphone/ui/controls.py:55
msgid "Normal"
msgstr "Normal"

#: app/biglinux_microphone/ui/controls.py:56
msgid "Strict"
msgstr "Rigorosa"

#: app/biglinux_microphone/ui/controls.py:57
msgid "Very strict"
msgstr "Muito rigorosa"

#: app/biglinux_microphone/ui/controls.py:62
msgid "Natural"
msgstr "Natural"

#: app/biglinux_microphone/ui/controls.py:63
msgid "Podcast"
msgstr "Podcast"

#: app/biglinux_microphone/ui/controls.py:64
msgid "Custom"
msgstr "Personalizado"

#: app/biglinux_microphone/ui/controls.py:131
msgid "Noise reduction"
msgstr "Redução de ruído"

#: app/biglinux_microphone/ui/controls.py:132
msgid "Applications hear your voice with less background noise."
msgstr "Os aplicativos recebem sua voz com menos ruído de fundo."

#: app/biglinux_microphone/ui/controls.py:150
msgid "How much noise to remove"
msgstr "Quanto ruído remover"

#: app/biglinux_microphone/ui/controls.py:157
msgid "Values set on the command line replace the recommended ones for DFN3."
msgstr ""
"Valores definidos pela linha de comando substituem os recomendados para o "
"DFN3."

#: app/biglinux_microphone/ui/controls.py:161
msgid "Restore"
msgstr "Restaurar"

#: app/biglinux_microphone/ui/controls.py:167
msgid "Intensity"
msgstr "Intensidade"

#: app/biglinux_microphone/ui/controls.py:168
msgid "Lower values preserve more of the original sound."
msgstr "Valores menores preservam mais do som original."

#: app/biglinux_microphone/ui/controls.py:180
msgid "Echo cancellation"
msgstr "Cancelamento de eco"

#: app/biglinux_microphone/ui/controls.py:181
msgid "Prevents sound from your speakers returning through the microphone."
msgstr "Evita que o som dos alto-falantes volte pelo microfone."

#: app/biglinux_microphone/ui/controls.py:182
#: app/biglinux_microphone/ui/controls.py:721
msgid "Automatic"
msgstr "Automático"

#: app/biglinux_microphone/ui/controls.py:182
msgid "Always on"
msgstr "Sempre ligado"

#: app/biglinux_microphone/ui/controls.py:195
#: app/biglinux_microphone/ui/controls.py:199
msgid "Microphone in use"
msgstr "Microfone em uso"

#: app/biglinux_microphone/ui/controls.py:220
msgid "Voice sound"
msgstr "Som da voz"

#: app/biglinux_microphone/ui/controls.py:221
msgid "Choose a ready-made sound, or customise your voice."
msgstr "Escolha um perfil pronto ou personalize o som da sua voz."

#: app/biglinux_microphone/ui/controls.py:249
#, python-format
msgid "%s Hz gain"
msgstr "Ganho em %s Hz"

#: app/biglinux_microphone/ui/controls.py:265
msgid "Restore custom equalizer"
msgstr "Restaurar o equalizador personalizado"

#: app/biglinux_microphone/ui/controls.py:269
msgid "Up boosts a band, down reduces it. 0 dB leaves it unchanged."
msgstr ""
"Para cima, aumenta o volume da faixa; para baixo, diminui. Em 0 dB, não há "
"alteração."

#: app/biglinux_microphone/ui/controls.py:279
#: app/biglinux_microphone/ui/controls.py:314
msgid "Noise that still gets through"
msgstr "Ruídos que ainda passam"

#: app/biglinux_microphone/ui/controls.py:279
#: app/biglinux_microphone/ui/widgets/setting_cards.py:363
#: app/biglinux_microphone/ui/widgets/setting_cards.py:375
msgid "On"
msgstr "Ligado"

#: app/biglinux_microphone/ui/controls.py:299
msgid "Voice detection"
msgstr "Detecção de voz"

#: app/biglinux_microphone/ui/controls.py:304
msgid ""
"Sensitive keeps quiet voices and lets more noise through; strict mutes more "
"noise and may cut faint words."
msgstr ""
"A detecção sensível mantém vozes baixas e deixa passar mais ruído; a "
"rigorosa silencia mais ruído e pode cortar palavras ditas em voz baixa."

#: app/biglinux_microphone/ui/controls.py:315
msgid "Mutes leftover noise while you are not talking."
msgstr "Silencia o ruído que sobra enquanto você não fala."

#: app/biglinux_microphone/ui/controls.py:338
#: app/biglinux_microphone/ui/controls.py:392
msgid "Microphone volume"
msgstr "Volume do microfone"

