#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:58
#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:75
msgid "Could not read the audio status. Open settings to check the connection."
msgstr ""
"Não foi possível verificar o estado do áudio. Abra as configurações para "
"verificar a conexão."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:79
msgid ""
"The change could not be applied. Your previous choices have been kept where "
"possible. Open settings for details."
msgstr ""
"Não foi possível aplicar a alteração. Suas escolhas anteriores foram "
"mantidas quando possível. Abra as configurações para ver os detalhes."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:121
msgid "Microphone and system sound filters"
msgstr "Filtros do microfone e do som do sistema"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:122
msgid "Audio needs attention. Open the controls for details."
msgstr "O áudio precisa de atenção. Abra os controles para ver os detalhes."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:122
msgid "Open audio filter controls"
msgstr "Abrir os controles dos filtros de áudio"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:131
msgid "Filter noise"
msgstr "Filtro de ruído"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:138
msgid "Some audio filters are not ready. Open settings to check them."
msgstr ""
"Alguns filtros de áudio não estão prontos. Abra as configurações para "
"verificá-los."

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:144
msgid "Microphone filter"
msgstr "Filtro do microfone"

#: usr/share/plasma/plasmoids/br.com.biglinux.micnoise/contents/ui/main.qml:146
